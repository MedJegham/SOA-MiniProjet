{
  "name": "platforma",
  "version": "1.0.0",
  "description": "Intelligent Reservation Platform - SoA Microservices Project",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "gateway": "node api-gateway/server.js",
    "auth": "node services/auth-service/server.js",
    "booking": "node services/booking-service/server.js",
    "payment": "node services/payment-service/server.js",
    "notification": "node services/notification-service/server.js",
    "dev:gateway": "nodemon api-gateway/server.js",
    "dev:auth": "nodemon services/auth-service/server.js",
    "dev:booking": "nodemon services/booking-service/server.js",
    "dev:payment": "nodemon services/payment-service/server.js",
    "dev:notification": "nodemon services/notification-service/server.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest tests/unit --runInBand --forceExit",
    "test:integration": "jest tests/integration --runInBand --forceExit",
    "test:coverage": "jest --runInBand --forceExit --coverage",
    "lint": "eslint . --ext .js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.1",
    "@grpc/proto-loader": "^0.7.10",
    "apollo-server-express": "^3.13.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "graphql": "^16.8.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1",
    "winston": "^3.12.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louaybenmansour/platforma.git"
  },
  "keywords": ["microservices", "grpc", "kafka", "nodejs", "soa"],
  "author": "",
  "license": "ISC",
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "collectCoverage": false,
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "lines": 70
      }
    },
    "coveragePathIgnorePatterns": ["/node_modules/"]
  }
}
