{
  "info": {
    "name": "Platforma — API Gateway",
    "description": "Collection complète pour tester tous les endpoints REST de la plateforme de réservation intelligente.\n\n## Utilisation\n1. Importer ce fichier dans Postman\n2. Créer un environnement avec la variable `baseUrl = http://localhost:3000`\n3. Exécuter **Register** puis **Login** — le token JWT est automatiquement stocké dans la variable `token`\n4. Toutes les requêtes protégées utilisent `{{token}}` automatiquement",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",   "value": "http://localhost:3000", "type": "string" },
    { "key": "token",     "value": "",                      "type": "string" },
    { "key": "userId",    "value": "",                      "type": "string" },
    { "key": "slotId",    "value": "",                      "type": "string" },
    { "key": "bookingId", "value": "",                      "type": "string" },
    { "key": "paymentId", "value": "",                      "type": "string" },
    { "key": "invoiceId", "value": "",                      "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "description": "Vérifie que l'API Gateway est opérationnelle."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@platforma.tn\",\n  \"password\": \"pass1234\",\n  \"name\": \"Alice Ben Ali\",\n  \"role\": \"client\"\n}"
            },
            "description": "Crée un nouveau compte utilisateur."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('userId present', () => pm.expect(json.userId).to.be.a('string'));",
                  "pm.collectionVariables.set('userId', json.userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@platforma.tn\",\n  \"password\": \"pass1234\"\n}"
            },
            "description": "Authentifie l'utilisateur et retourne un JWT. Le token est automatiquement sauvegardé."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('token present', () => pm.expect(json.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', json.token);",
                  "pm.collectionVariables.set('userId', json.userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login — identifiants invalides",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@platforma.tn\",\n  \"password\": \"mauvais_mdp\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/{{userId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Récupère le profil de l'utilisateur connecté."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('correct userId', () => pm.expect(json.id).to.eql(pm.collectionVariables.get('userId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update User Profile",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/users/{{userId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Ben Ali (modifié)\",\n  \"email\": \"alice@platforma.tn\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('name updated', () => pm.expect(pm.response.json().profile.name).to.include('modifié'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Slots",
      "item": [
        {
          "name": "Create Slot",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/slots",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": \"svc-coiffure-001\",\n  \"startTime\": 1756684800000,\n  \"endTime\":   1756688400000,\n  \"capacity\": 5,\n  \"price\": 45.0\n}"
            },
            "description": "Crée un créneau disponible pour un service. startTime/endTime en millisecondes Unix."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('slotId present', () => pm.expect(json.slotId).to.be.a('string'));",
                  "pm.collectionVariables.set('slotId', json.slotId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Available Slots",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/slots?serviceId=svc-coiffure-001&date=1756684800000",
              "query": [
                { "key": "serviceId", "value": "svc-coiffure-001" },
                { "key": "date",      "value": "1756684800000" }
              ]
            },
            "description": "Liste les créneaux disponibles pour un service à une date donnée (timestamp ms)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('slots array', () => pm.expect(pm.response.json().slots).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Slots — serviceId manquant",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/slots"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/bookings",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"{{slotId}}\"\n}"
            },
            "description": "Réserve un créneau pour l'utilisateur connecté."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('bookingId present', () => pm.expect(json.bookingId).to.be.a('string'));",
                  "pm.collectionVariables.set('bookingId', json.bookingId);"
                ]
              }
            }
          ]
        },
        {
          "name": "List My Bookings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/bookings",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('bookings array', () => pm.expect(pm.response.json().bookings).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Booking by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Changement de planning\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('success true', () => pm.expect(pm.response.json().success).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Process Payment",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/payments",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"amount\": 45.0,\n  \"method\": \"card\",\n  \"currency\": \"TND\"\n}"
            },
            "description": "Traite le paiement d'une réservation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('paymentId present', () => pm.expect(json.paymentId).to.be.a('string'));",
                  "pm.test('status completed', () => pm.expect(json.status).to.eql('completed'));",
                  "pm.collectionVariables.set('paymentId', json.paymentId);"
                ]
              }
            }
          ]
        },
        {
          "name": "List My Payments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/payments",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('payments array', () => pm.expect(pm.response.json().payments).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Payment Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/payments/{{paymentId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('paymentId matches', () => pm.expect(pm.response.json().paymentId).to.eql(pm.collectionVariables.get('paymentId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refund Payment",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/payments/{{paymentId}}/refund",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Service non conforme\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('success true', () => pm.expect(pm.response.json().success).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Invoice",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/invoices/{{bookingId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Récupère la facture associée à une réservation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('invoice present', () => pm.expect(pm.response.json()).to.have.property('id'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Get Notification History",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/notifications",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('notifications array', () => pm.expect(pm.response.json().notifications).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Notification Preferences",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/notifications/preferences",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('has emailNotifications', () => pm.expect(json).to.have.property('emailNotifications'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Notification Preferences",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/notifications/preferences",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailNotifications\": true,\n  \"smsNotifications\": false,\n  \"pushNotifications\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('push updated', () => pm.expect(pm.response.json().pushNotifications).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "GraphQL",
      "item": [
        {
          "name": "GraphQL — Login (mutation)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/graphql",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation { login(email: \\\"alice@platforma.tn\\\", password: \\\"pass1234\\\") { token userId role } }\"\n}"
            },
            "description": "Connexion via GraphQL."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('no errors', () => pm.expect(json.errors).to.be.undefined);",
                  "pm.test('token present', () => pm.expect(json.data.login.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', json.data.login.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "GraphQL — My Bookings (query)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/graphql",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query { myBookings(limit: 10, offset: 0) { bookings { id status totalPrice createdAt slot { startTime endTime price } } total } }\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('no errors', () => pm.expect(pm.response.json().errors).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "GraphQL — Available Slots (query)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/graphql",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query { slots(serviceId: \\\"svc-coiffure-001\\\", date: 1756684800000) { slots { id startTime endTime capacity booked price } totalAvailable } }\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('no errors', () => pm.expect(pm.response.json().errors).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "GraphQL — My Payments (query)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/graphql",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query { myPayments { payments { id amount method status currency } total } }\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('no errors', () => pm.expect(pm.response.json().errors).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "GraphQL — Register (mutation)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/graphql",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation { register(email: \\\"graphql_user@platforma.tn\\\", password: \\\"pass9999\\\", name: \\\"GraphQL User\\\") { token userId role } }\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('no errors', () => pm.expect(pm.response.json().errors).to.be.undefined);"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
